# Backend API base URL used by app/lib/api.ts
# Local backend default: http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Production (Vercel App project only — see DEPLOYMENT.md and .env.production.example):
# NEXT_PUBLIC_API_URL=https://api.jamiiaide.com/api

# Optional request timeout in milliseconds (default in code: 15000)
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Optional Google OAuth client ID. Required for Google sign-in button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
